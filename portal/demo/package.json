{
  "name": "pharma-portal-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Кликабельное демо портала государственной регистрации на условных данных",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "turbo run dev --filter=@demo/web-portal",
    "dev:cn": "turbo run dev --filter=@demo/web-cn",
    "dev:ru": "turbo run dev --filter=@demo/web-ru",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test --filter=@demo/web-cn --filter=@demo/ui --filter=@demo/contracts",
    "test:e2e": "playwright test",
    "check:copy": "node scripts/check-copy.mjs",
    "serve": "node scripts/serve-demo.mjs",
    "demo": "pnpm run check:copy && pnpm run build && pnpm run serve"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "turbo": "^2.5.6",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
