# Публичные адреса контура. Секретов здесь нет и быть не может: всё, что попадает
# в VITE_*, уезжает в браузер вместе с бандлом.
#
# Скопировать в .env и запускать pnpm run dev / dev:cn / dev:ru. В CI те же
# значения задаются на шаге сборки в .github/workflows/deploy.yml.

# Ядро кабинета и чат агента — один origin: SPA говорит только с Edge.
VITE_API_URL=https://pharma-edge.sinoptics.ru
VITE_AGENT_API=https://pharma-edge.sinoptics.ru

# Публичный клиент с PKCE. Redirect URIs realm покрывают pharma.sinoptics.ru
# и localhost:5173 (web-cn), :5174 (web-ru), :5175 (web-portal).
VITE_KEYCLOAK_URL=https://auth.sinoptics.ru
VITE_KEYCLOAK_REALM=pharma
VITE_KEYCLOAK_CLIENT_ID=medmost-spa

# EDGE_API_KEY и прочие ключи в этот файл не попадают: X-API-Key — служебный
# путь агента и вебхуков Plane, в браузере он не живёт.
